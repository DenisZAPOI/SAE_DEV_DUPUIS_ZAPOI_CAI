# Copier en .env (jamais committé) et renseigner les vraies valeurs.
# ATTENTION : le code actuel (Git/utils/connexion.php) ne lit pas encore ces variables ;
# elles documentent la configuration cible (voir CLAUDE.md, « Points d'attention »).

# Base de données MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_bar
DB_USER=changeme
DB_PASSWORD=changeme
DB_CHARSET=utf8mb4

# Environnement : dev | prod
APP_ENV=dev
