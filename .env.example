# Copier en .env à la racine du projet (jamais committé) et renseigner les vraies valeurs.
# Lu par Git/utils/config.php ; une variable d'environnement du serveur prime sur le fichier.
# Aucune valeur par défaut n'existe dans le code : une clé manquante bloque la connexion.

# Base de données MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_bar
DB_USER=changeme
DB_PASSWORD=changeme
# Pas encore utilisée par le DSN : sera branchée par le correctif INJ-01.
DB_CHARSET=utf8mb4

# Environnement : dev | prod
APP_ENV=dev
